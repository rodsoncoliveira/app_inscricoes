# Copie para .streamlit/secrets.toml (local) ou cadastre no Streamlit Cloud.
# Nunca commite senhas reais no GitHub.

admin_password = "troque-por-uma-senha-forte"

# Formato recomendado (senha com @, #, % funciona sem encoding)
[database]
host = "aws-0-sa-east-1.pooler.supabase.com"
port = 6543
user = "postgres.SEU_PROJECT_REF"
password = "SUA_SENHA"
dbname = "postgres"
sslmode = "require"

# Alternativa: URL única (senha com caracteres especiais precisa ser codificada)
# @ vira %40 | # vira %23 | % vira %25
# DATABASE_URL = "postgresql://postgres.xxxxx:SENHA%40CODIFICADA@HOST:6543/postgres?sslmode=require"
